# COST-SAFE DEFAULT: the app runs locally and all outbound provider requests are blocked.
# Keep every flag below false/empty for free local development and synthetic tests.
# Optional bKash Checkout sandbox lookups can contact the provider ONLY if you explicitly
# switch all required flags on. Check current provider terms before doing so.
PAYCHECKPOINT_ALLOW_EXTERNAL_PROVIDER_REQUESTS=false

# Optional bKash Checkout sandbox lookup (Steps 7–9). This is disabled by default.
# Obtain credentials from bKash through an authorized merchant integration account.
# Never put production credentials here. Never commit .env.local.
BKASH_SANDBOX_ENABLED=false
# Separate explicit approval gate for all outbound sandbox lookups. Keep false until ready.
BKASH_SANDBOX_LIVE_LOOKUPS_APPROVED=false
BKASH_SANDBOX_USERNAME=
BKASH_SANDBOX_PASSWORD=
BKASH_SANDBOX_APP_KEY=
BKASH_SANDBOX_APP_SECRET=

# Optional references for `npm run bkash:live-validation`. Use synthetic references
# from your authorized merchant sandbox only. Values are never printed or included in reports.
BKASH_TEST_PAYMENT_ID_COMPLETED=
BKASH_TEST_PAYMENT_ID_PENDING=
BKASH_TEST_PAYMENT_ID_FAILED=
BKASH_TEST_TRX_ID_UNKNOWN=

# Cloud AI is deliberately NOT configured through an API key.
# For the public demo, deploy to Cloudflare Pages and add a Workers AI binding named AI.
# The documented free allocation is limited (currently 10,000 Neurons/day); requests may fail when exhausted.
# Local Node mode never calls a hosted AI provider.
