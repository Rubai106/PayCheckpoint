{
  "name": "paycheckpoint-website",
  "version": "1.27.2",
  "private": true,
  "description": "Bilingual local-first payment safety, source-aware evidence, incident preparation, and safer cancelable OCR workflows",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "qa:browser": "python qa/browser_qa.py",
    "setup:backend": "node scripts/setup-backend.mjs",
    "bkash:preflight": "node scripts/bkash-preflight.mjs",
    "bkash:live-validation": "node scripts/bkash-live-validation.mjs",
    "qa:evaluation": "node scripts/run-synthetic-benchmark.mjs",
    "qa:recovery": "python qa/recovery_navigator_qa.py",
    "qa:incident-dossier": "python qa/incident_dossier_qa.py",
    "qa:share-brief": "python qa/share_brief_qa.py",
    "qa:receipt-lens": "python qa/receipt_lens_qa.py",
    "build:pages": "node scripts/build-pages.mjs",
    "qa:pages-build": "node tests/pages-build.test.mjs",
    "qa:sequence": "python qa/sequence_intelligence_qa.py",
    "qa:sequence-evaluation": "node scripts/run-conversation-sequence-benchmark.mjs",
    "qa:focus": "python qa/accessibility_focus_qa.py",
    "qa:benchmark-ui": "python qa/scam_benchmark_ui_qa.py",
    "qa:evidence-integrity": "python qa/evidence_integrity_qa.py",
    "qa:report-download": "python qa/report_download_qa.py",
    "qa:followup": "python qa/followup_planner_qa.py",
    "qa:conversation-independent": "node scripts/evaluate-conversation-annotations.mjs",
    "qa:ocr-independent": "node scripts/evaluate-receipt-ocr.mjs",
    "qa:usability-summary": "node scripts/analyze-usability-sessions.mjs",
    "qa:independent-eval": "npm run qa:conversation-independent && npm run qa:ocr-independent && npm run qa:usability-summary",
    "qa:release": "node scripts/run-release-validation.mjs",
    "generate:receipt-pilot": "python scripts/generate-receipt-lens-pilot.py",
    "qa:receipt-pilot": "node scripts/run-receipt-lens-pilot.mjs --psm 6",
    "qa:receipt-pilot-psm3": "node scripts/run-receipt-lens-pilot.mjs --psm 3 --output evaluation/receipt-lens-pilot/results/tesseract-cli-psm3.json",
    "qa:receipt-pilot-psm11": "node scripts/run-receipt-lens-pilot.mjs --psm 11 --output evaluation/receipt-lens-pilot/results/tesseract-cli-psm11.json",
    "qa:first-time": "python qa/first_time_journey_qa.py",
    "qa:served-origin": "python qa/served_origin_qa.py",
    "qa:responsive": "python qa/responsive_app_screens_qa.py",
    "qa:live-copilot": "node scripts/verify-live-copilot.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
